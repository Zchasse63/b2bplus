# Supabase Configuration
# Get these values from https://supabase.com/dashboard/project/ksprdklquoskvjqsicvv/settings/api

# Web App (.env.local in apps/web)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Migration Scripts (required for scripts/apply-migration.ts)
SUPABASE_URL=your_supabase_url

# SendGrid Configuration (for email campaigns and webhooks)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_WEBHOOK_VERIFICATION_KEY=your_sendgrid_webhook_verification_public_key
# Get verification key from: https://app.sendgrid.com/settings/mail_settings > Event Webhook > Signed Event Webhook

# Mobile App (.env in apps/mobile)
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

