# ============================================================================
# Supabase Configuration (Required)
# ============================================================================
# Get these values from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ============================================================================
# Google Gemini AI (Required)
# ============================================================================
# Get API key from https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# ============================================================================
# SendGrid Email (Required)
# ============================================================================
# Get these from https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=Your Company Name
SENDGRID_REPLY_TO_EMAIL=support@yourdomain.com

# ============================================================================
# SendGrid Webhooks (Optional)
# ============================================================================
# Only needed if using SendGrid inbound email webhooks
# Get from https://app.sendgrid.com/settings/mail_settings -> Inbound Parse
SENDGRID_WEBHOOK_SIGNING_KEY=your_webhook_signing_key_here

# ============================================================================
# Upstash Redis (Optional - for rate limiting)
# ============================================================================
# Get these from https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# ============================================================================
# Sentry Error Tracking (Optional)
# ============================================================================
# Get DSN from https://sentry.io/settings/projects/
NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# ============================================================================
# Application Configuration
# ============================================================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================================
# AI Model Configuration (Optional)
# ============================================================================
# Model to use for invoice auto-approval (default: grok-4-1-fast)
INVOICE_AUTO_APPROVAL_MODEL=grok-4-1-fast

# ============================================================================
# Sales Team Configuration (Optional)
# ============================================================================
# Comma-separated list of email addresses for lead notifications
SALES_TEAM_EMAILS=sales1@yourdomain.com,sales2@yourdomain.com

# ============================================================================
# Email Webhook (Optional)
# ============================================================================
# Secret for authenticating inbound email webhooks
EMAIL_WEBHOOK_SECRET=your_webhook_secret_here

# ============================================================================
# Test Configuration (Optional)
# ============================================================================
# E2E test user credentials (should match test users in Supabase)
TEST_USER_EMAIL=test@testmail.app
TEST_USER_PASSWORD=TestPassword123!
TEST_ADMIN_EMAIL=admin@testmail.app
TEST_ADMIN_PASSWORD=AdminPassword123!

# Integration test configuration
# Leave blank to run tests in mock mode (no real database)
# Set these to run full integration tests with real Supabase instance:
# TEST_SUPABASE_URL=https://your-test-project.supabase.co
# TEST_SUPABASE_ANON_KEY=your_test_anon_key
# TEST_SUPABASE_SERVICE_ROLE_KEY=your_test_service_role_key

# ============================================================================
# Mobile App (.env in apps/mobile)
# ============================================================================
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
